# Neon Postgres (HTTP Serverless & Pooled Connection)
DATABASE_URL="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Neon Serverless Functions
NEON_FUNCTION_HELLO_BASE_URL="https://br-example-hello.compute.ap-southeast-1.aws.neon.tech"

# Neon Auth
NEON_AUTH_BASE_URL="https://ep-example.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-example.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon Realtime
NEON_REALTIME_URL="wss://ep-example.rt.c-1.ap-southeast-1.aws.neon.tech/"
NEON_REALTIME_SECRET="nrt_live_example"

# Neon Object Storage (AWS S3 Protocol Compatible)
AWS_ACCESS_KEY_ID="nak_live_example"
AWS_SECRET_ACCESS_KEY="nsk_live_example"
AWS_ENDPOINT_URL_S3="https://br-example.storage.c-1.ap-southeast-1.aws.neon.tech"
AWS_REGION="ap-southeast-1"
